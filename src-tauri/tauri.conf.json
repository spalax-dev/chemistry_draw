{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chemistry-draw",
  "version": "0.1.6",
  "identifier": "dev.spalax.ChemistryDraw",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chemistry Draw",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "category": "Education",
    "shortDescription": "Desktop chemical structure editor",
    "longDescription": "Chemistry Draw is an unofficial desktop wrapper of Ketcher (Apache 2.0, EPAM Systems). Draw molecules, reactions and macromolecules offline.\n\nBuilt with Tauri (Rust + React/TypeScript) on top of native Indigo cheminformatics. Image-to-structure recognition (Imago) is available in Linux builds only; Windows builds ship without it.",
    "licenseFile": "../LICENSE"
  }
}
