# Native Indigo libs are built, not vendored: `task libs` (or the Docker
# builder) generates them. Packages ship them; they are never committed.
src-tauri/lib/linux-x86_64/

# Windows runtime comes from scripts/fetch-windows-libs.ps1 (pinned Indigo
# 1.46.0). DLLs and generated MSVC import libraries are never vendored.
src-tauri/lib/windows-x86_64/

# ONNX models are downloaded, not vendored. Developers and tests place them
# under models/ (see docs/architecture.md); the directory is never committed.
models/

# ONNX Runtime shared library for local inference (dev/test only). Fetched by
# scripts/fetch-onnxruntime.sh into .ort/<platform>/ and selected through
# ORT_DYLIB_PATH. Packages ship the builder's copy (see docs/DEVELOPMENT.md),
# never this directory.
.ort/

# Local session state (kept on disk, not tracked)
activities.json
progress/current.md

