# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules
.pnpm-store/

# vendor/ is deliberately NOT ignored: if the project ever vendors
# dependencies, they are tracked (see docs/harness/git-tracking.md).

# Build output and the consolidated generated-artifact root
target/
dist
dist-ssr
build/
sidecar/target/
*.local

# Generated documentation (build output; never hand-edited)
docs/generated/
target/doc/

# Harness session state (local only)
/activities.json
/progress/current.md
/.harness/*
!/.harness/state.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local packaging and chemistry output
test_*.png
*_result.mol
*.AppImage

# Native Indigo libs are built, not vendored: `task libs` (or the Docker
# builder) generates them. Packages ship them; they are never committed.
src-tauri/lib/linux-x86_64/

# Windows runtime comes from scripts/fetch-windows-libs.ps1 (pinned Indigo
# 1.46.0). DLLs and generated MSVC import libraries are never vendored.
src-tauri/lib/windows-x86_64/

# ONNX models are downloaded, not vendored. Developers and tests place them
# under models/ (see docs/planning/architecture.md); the directory is never
# committed.
models/

# ONNX Runtime shared library for local inference (dev/test only). Fetched by
# scripts/fetch-onnxruntime.sh into .ort/<platform>/ and selected through
# ORT_DYLIB_PATH. Packages ship the builder's copy (see
# docs/planning/architecture.md), never this directory.
.ort/
