{
  "name": "chemistry-draw",
  "private": true,
  "version": "0.1.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "test": "vitest run",
    "harness": "node scripts/harness.mjs",
    "harness:stage": "node scripts/harness.mjs --stage",
    "harness:planning": "node scripts/harness.mjs --planning",
    "harness:start-dev": "node scripts/harness.mjs --start-dev",
    "harness:schedule": "node scripts/harness.mjs --schedule",
    "harness:fast": "node scripts/harness.mjs --fast",
    "harness:changed": "node scripts/harness.mjs --changed",
    "harness:explain": "node scripts/harness.mjs --explain",
    "build:harness": "node scripts/build_harness.mjs",
    "test:harness": "node --test scripts/harness-lib.spec.mjs",
    "docs:gen": "bash scripts/docsgen.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "ketcher-core": "^3.18.0",
    "ketcher-react": "^3.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
